# Copiez ce fichier en .env puis changez TOUTES les valeurs. Ne committez jamais .env.
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-root

# Clé de signature des jetons de connexion : au moins 32 caractères aléatoires.
#   openssl rand -base64 48
APP_JWT_SECRET=

# true derrière HTTPS (production). false uniquement pour un essai en http local.
APP_COOKIE_SECURE=false

# Port exposé par Nginx
HTTP_PORT=8080

# Vide en production. "dev" charge des comptes et des données d'exemple (jamais en production).
SPRING_PROFILES_ACTIVE=
